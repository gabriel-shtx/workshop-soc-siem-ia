# ============================================================
# MODELO de variáveis de ambiente. NUNCA comite o .env real.
# Copie para .env e preencha localmente:  cp .env.example .env
# ============================================================

# AbuseIPDB — https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# NVIDIA (Mistral Nemotron) — https://build.nvidia.com
NVIDIA_API_KEY=

# Resend — https://resend.com/api-keys
RESEND_API_KEY=

# Webhook do n8n (ajuste host/porta ao seu ambiente)
N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/wazuh-alert

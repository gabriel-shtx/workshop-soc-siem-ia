<!-- ========================================================================
     AULA 3 — cenário principal do pipeline automatizado
     Força bruta SSH seguida de login BEM-SUCEDIDO, do mesmo IP de origem.
     É o evento que dispara o fluxo Wazuh → n8n → AbuseIPDB → IA → Resend.
     ======================================================================== -->
<group name="custom_ssh,">
  <rule id="100501" level="15">
    <if_sid>5715</if_sid>                    <!-- login SSH com sucesso -->
    <if_matched_sid>5712</if_matched_sid>    <!-- após falhas de SSH      -->
    <same_srcip>yes</same_srcip>             <!-- do MESMO IP de origem    -->
    <description>SSH_BruteForce_Seguido_Sucesso</description>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>
</group>

<!-- ========================================================================
     AULA 2 — detecção de comportamento (correlação de TTPs)
     Regra didática do grupo fictício "Evil Art": um usuário é criado logo
     após uma força bruta no sudo. Um evento sozinho é ambíguo; a SEQUÊNCIA
     é que denuncia o comportamento do adversário.
     ======================================================================== -->
<group name="evil_art,">
  <rule id="100210" level="14" timeframe="300">
    <if_sid>5902</if_sid>                    <!-- usuário criado no endpoint -->
    <if_matched_sid>5503</if_matched_sid>    <!-- após falhas de autenticação -->
    <description>Comportamento do Evil Art detectado!</description>
    <mitre>
      <id>T1110.001</id>
      <id>T1136.001</id>
    </mitre>
  </rule>
</group>
